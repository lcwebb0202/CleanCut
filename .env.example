# Copy this file to ".env" (in the same folder) and change the lines below.

# 1. The folder with your movies. CleanCut can only see (and save to) this folder and the folders
#    inside it. Use forward slashes, like this:
MEDIA_DIR=C:/Users/YourName/Movies

# 2. Only if your computer has an NVIDIA graphics card: remove the # from the next two lines.
#    It makes CleanCut several times faster. Without it, CleanCut uses the processor (slower, still works).
# COMPOSE_FILE=docker-compose.yml;docker-compose.gpu.yml
# COMPOSE_PATH_SEPARATOR=;
